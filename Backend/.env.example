# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bankledger?retryWrites=true&w=majority

# JWT Signing Secret
JWT_SECRET=super_secure_random_string_here_minimum_32_chars

# Port (Render/Railway sets this automatically, default 3000)
PORT=3000

# Allowed Frontend URL for CORS (e.g., https://your-bankledger-frontend.vercel.app)
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# Optional: Google OAuth2 Gmail Service for Notifications & OTPs
EMAIL_USER=your-email@gmail.com
CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_oauth_client_secret
REFRESH_TOKEN=your_oauth_refresh_token

